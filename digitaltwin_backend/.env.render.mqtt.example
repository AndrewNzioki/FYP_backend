# MQTT broker
MQTT_BROKER_HOST=your-broker.example.com
MQTT_BROKER_PORT=8883
MQTT_CLIENT_ID=digitaltwin-backend-worker
MQTT_KEEPALIVE=60
MQTT_CLEAN_SESSION=False
MQTT_TRANSPORT=tcp

# MQTT credentials
MQTT_USERNAME=your-username
MQTT_PASSWORD=your-password

# Topics and QoS
MQTT_TELEMETRY_STATE_TOPIC=plant/telemetry/state
MQTT_TELEMETRY_HEALTH_TOPIC=plant/telemetry/health
MQTT_COMMAND_TOPIC=plant/command/set_mode
MQTT_TELEMETRY_QOS=1
MQTT_COMMAND_QOS=2

# Worker loop behavior
MQTT_COMMAND_POLL_INTERVAL_SECONDS=1.0
MQTT_COMMAND_BATCH_SIZE=20
MQTT_PUBLISH_ACK_TIMEOUT_SECONDS=10.0
MQTT_RECONNECT_DELAY_MIN_SECONDS=1
MQTT_RECONNECT_DELAY_MAX_SECONDS=60

# TLS
MQTT_TLS_ENABLED=True
MQTT_TLS_CA_CERT=/etc/secrets/mqtt/ca.crt
MQTT_TLS_CERTFILE=
MQTT_TLS_KEYFILE=
MQTT_TLS_INSECURE=False
MQTT_TLS_VERSION=TLSv1_2

